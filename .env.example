# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
APP_NAME=LifeOS
APP_VERSION=1.0.0
PORT=3000
HOST=0.0.0.0

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=./logs

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lifeos
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30000
DATABASE_LOGGING=false

# ============================================
# REDIS CACHE CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# API CONFIGURATION
# ============================================
API_PREFIX=/api/v1
CORS_ORIGIN=*
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# AUTHENTICATION (JWT)
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRY=7d

# ============================================
# ML MODELS CONFIGURATION
# ============================================
ML_MODELS_PATH=./models
ML_BATCH_SIZE=32
ML_CONFIDENCE_THRESHOLD=0.7
ML_MODEL_TIMEOUT=30000

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
ENABLE_PROMETHEUS=true
ENABLE_JAEGER=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ============================================
# HEALTH CHECK CONFIGURATION
# ============================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ============================================
# RECOVERY CONFIGURATION
# ============================================
RECOVERY_THRESHOLD=70
OPTIMIZATION_THRESHOLD=85
MAX_CONCURRENT_RECOVERIES=5
ENABLE_AUTO_RECOVERY=true
ENABLE_AUTO_OPTIMIZATION=true

# ============================================
# NOTIFICATION CONFIGURATION
# ============================================
EMAIL_ENABLED=false
EMAIL_FROM=noreply@lifeos. com
SMTP_HOST=smtp.gmail. com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# ============================================
# ERROR TRACKING (Sentry)
# ============================================
SENTRY_ENABLED=false
SENTRY_DSN=

# ============================================
# PYTHON ML SERVICE
# ============================================
PYTHON_SERVICE_URL=http://localhost:5001
PYTHON_SERVICE_TIMEOUT=30000

# ============================================
# SECURITY
# ============================================
ENCRYPTION_KEY=change_me_in_production_32_character_key
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ============================================
# PERSISTENCE
# ============================================
PERSISTENCE_ENABLED=true
PERSISTENCE_INTERVAL=300000

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AUTO_RECOVERY=true
FEATURE_OPTIMIZATION=true
FEATURE_LEARNING=true
FEATURE_REPORTING=true
FEATURE_ADVANCED_ANALYTICS=false