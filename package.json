{
  "name": "lifeos-neural-platform",
  "version": "1.0.0",
  "description": "Autonomous Incident Recovery System with ML-Powered Anomaly Detection and Self-Healing Capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Houston-g",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "db:migrate": "typeorm migration:run -d src/database/connection.ts",
    "db:revert": "typeorm migration:revert -d src/database/connection.ts",
    "train-models": "python python/scripts/train.py",
    "evaluate-models": "python python/scripts/evaluate.py",
    "docker:build": "docker build -t lifeos:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "health-check": "curl -s http://localhost:3000/api/v1/health | jq",
    "pretest": "npm run lint",
    "prepush": "npm run type-check && npm run test",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.11.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.0",
    "prom-client": "^15.0.0",
    "redis": "^4.6.10",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
